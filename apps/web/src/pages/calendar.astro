---
import Layout from "../layouts/Layout.astro";
import CalendarMonth from "../components/CalendarMonth.tsx";
---
<Layout title="直播日历 - A-SOUL Timeline">
  <CalendarMonth client:load />
</Layout>

<style is:global>
.cal-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 0.5rem;
}
.cal-header h1 { margin: 0; }
.cal-ics-btn {
  display: flex; align-items: center; gap: 4px;
  padding: 6px 14px;
  border: 1px solid #e0e0e0; border-radius: 8px;
  background: #fff; color: #666;
  font-size: 13px; text-decoration: none;
  transition: all 0.2s;
}
.cal-ics-btn:hover { border-color: #ff6b9d; color: #ff6b9d; background: #fff5f8; }

.cal { display: flex; flex-direction: column; gap: 0.8rem; }

/* 月份导航 */
.cal-nav {
  display: flex; align-items: center; justify-content: center; gap: 1.5rem;
}
.cal-nav-btn {
  width: 36px; height: 36px; border: 1px solid #e0e0e0;
  border-radius: 50%; background: #fff; cursor: pointer;
  font-size: 16px; color: #666; transition: all 0.2s;
}
.cal-nav-btn:hover { border-color: #ff6b9d; color: #ff6b9d; }
.cal-nav-title {
  font-size: 18px; font-weight: 600; color: #333;
  cursor: pointer; user-select: none; padding: 4px 12px;
  border-radius: 6px; transition: background 0.2s;
}
.cal-nav-title:hover { background: #f5f5f5; }
.cal-nav-arrow { font-size: 10px; color: #999; margin-left: 4px; }

/* 月份选择器 */
.cal-picker {
  background: #fff; border: 1px solid #eee; border-radius: 12px;
  padding: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);
}
.cal-picker-years {
  display: flex; align-items: center; justify-content: center; gap: 1rem;
  margin-bottom: 0.8rem; font-size: 15px; font-weight: 600;
}
.cal-picker-years button {
  border: 1px solid #e0e0e0; border-radius: 4px; background: #fff;
  cursor: pointer; padding: 2px 10px; color: #666;
}
.cal-picker-years button:hover { border-color: #ff6b9d; color: #ff6b9d; }
.cal-picker-months {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 0.8rem;
}
.cal-pm {
  padding: 8px 0; border: 1px solid #eee; border-radius: 6px;
  background: #fff; cursor: pointer; font-size: 13px; color: #666;
  transition: all 0.15s;
}
.cal-pm:hover { border-color: #ff6b9d; }
.cal-pm-active { background: #ff6b9d; color: #fff; border-color: #ff6b9d; }
.cal-pm-current { border-color: #ffb3cc; }
.cal-picker-ok {
  width: 100%; padding: 8px; border: none; border-radius: 6px;
  background: #ff6b9d; color: #fff; cursor: pointer; font-size: 14px; font-weight: 600;
}
.cal-picker-ok:hover { background: #ff5588; }

/* 月视图网格 */
.cal-grid {
  display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px;
  background: #f0f0f0; border-radius: 10px; overflow: hidden;
  border: 1px solid #f0f0f0;
  width: 90%; margin: 0 auto;
}
@media (max-width: 480px) {
  .cal-grid { width: 100%; gap: 1px; }
  .cal-cell { padding: 1px 2px; aspect-ratio: 2 / 1; }
  .cal-weekday { font-size: 10px; padding: 4px 0; }
  .cal-date { font-size: 12px; }
  .cal-dot { width: 5px; height: 5px; }
}
.cal-loading { opacity: 0.5; }
.cal-weekday {
  text-align: center; font-size: 12px; font-weight: 600;
  color: #999; padding: 8px 0; background: #fff;
}
.cal-cell {
  background: #fff; aspect-ratio: 5 / 4; padding: 3px 5px;
  cursor: pointer; transition: background 0.15s;
  display: flex; flex-direction: column; align-items: flex-start;
}
.cal-cell:hover { background: #fafafa; }
.cal-cell-out { color: #ccc; background: #fafafa; }
.cal-cell-today { background: #ffe0ec; }
.cal-cell-today .cal-date { color: #ff6b9d; font-weight: 700; }
.cal-cell[data-selected="true"] { background: #fff0f5; }
}
.cal-date { font-size: 13px; color: #555; line-height: 1.2; }
.cal-dots {
  display: flex; gap: 3px; margin-top: 4px; flex-wrap: wrap;
}
.cal-dot {
  width: 7px; height: 7px; border-radius: 50%; display: inline-block;
}

/* 日视图 */
.cal-day-view {
  background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 1rem 1.2rem;
}

/* 区块标题 */
.cal-section-title {
  font-size: 15px; font-weight: 600; color: #333;
  margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.5rem;
}
.cal-section-count {
  font-size: 12px; color: #999; font-weight: 400;
  background: #f5f5f5; padding: 2px 8px; border-radius: 10px;
}

/* 时间线列表 */
.sced-list { position: relative; padding-left: 20px; }
.sced-item-group { margin-bottom: 0.5rem; }
.sced-date-label {
  font-size: 12px; color: #999; margin-bottom: 0.3rem; font-weight: 600;
}
.sced-item {
  display: flex; gap: 0.6rem; text-decoration: none; color: inherit;
  padding: 0.6rem 0; position: relative;
  border-bottom: 1px solid #f5f5f5; transition: background 0.15s;
}
.sced-item:last-child { border-bottom: none; }
.sced-item:hover { background: #fafafa; margin: 0 -8px; padding: 0.6rem 8px; border-radius: 6px; }
.sced-item::before {
  content: ""; position: absolute; left: -14px; top: 14px;
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--dot-color, #ff6b9d);
  border: 2px solid #fff; box-shadow: 0 0 0 1.5px #eee;
}
.sced-list::before {
  content: ""; position: absolute; left: 9px; top: 0; bottom: 0;
  width: 2px; background: #f0f0f0;
}
.sced-body { flex: 1; min-width: 0; }
.sced-time-row {
  display: flex; align-items: center; gap: 0.5rem;
}
.sced-time {
  font-size: 13px; font-weight: 600; color: #ff6b9d;
}
.sced-type {
  font-size: 10px; padding: 1px 6px; border-radius: 8px;
  font-weight: 400;
}
.sced-type-single { background: #f0f0f0; color: #888; }
.sced-type-dual { background: #e3f2fd; color: #1976d2; }
.sced-type-group { background: #fff3e0; color: #f57c00; }

.sced-title {
  font-size: 14px; color: #333; margin: 2px 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.sced-author {
  display: flex; align-items: center; gap: 0.25rem;
  font-size: 12px; color: #999; text-decoration: none; color: inherit;
  flex-wrap: wrap;
}
.sced-author:hover { color: #555; }
.sced-avatar {
  width: 16px; height: 16px; border-radius: 50%; object-fit: cover;
}
.sced-avatar-fallback {
  width: 16px; height: 16px; border-radius: 50%;
  color: #fff; font-size: 9px; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.sced-author-name { color: #999; }
.sced-plus { color: #ccc; font-weight: 400; }

/* 近期直播 */
.cal-upcoming {
  background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 1rem 1.2rem;
}

/* 图例 */
.cal-legend {
  display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center;
  padding: 0.5rem;
}
.cal-legend-item {
  display: flex; align-items: center; gap: 4px;
  font-size: 12px; color: #888;
}

.cal-empty {
  color: #999; font-size: 14px; text-align: center; padding: 1rem 0;
}
</style>