---
import Layout from "../layouts/Layout.astro";
import LiveStatus from "../components/LiveStatus.tsx";
---
<Layout title="正在直播 - A-SOUL Timeline">
  <h1>正在直播</h1>
  <p class="ls-notice">数据每 30 分钟同步一次，可能并非实时。<br/>点击卡片可进入对应直播间。</p>
  <LiveStatus client:load />
</Layout>

<style is:global>
.ls-notice {
  font-size: 0.8rem; color: #999; margin-top: -0.5rem; margin-bottom: 0.5rem;
}
.ls-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
  margin-top: 1rem;
}
@media (max-width: 520px) {
  .ls-grid { grid-template-columns: 1fr; }
}

.ls-card {
  display: flex; flex-direction: column; align-items: center;
  padding: 1.2rem 0.8rem; border-radius: 12px;
  background: color-mix(in srgb, var(--color, #888) 8%, #fff);
  border: 2px solid color-mix(in srgb, var(--color, #888) 20%, transparent);
  text-decoration: none; color: inherit;
  transition: all 0.3s;
}
.ls-card:hover { transform: translateY(-2px); }
.ls-live {
  background: color-mix(in srgb, var(--color, #888) 15%, #fff);
  border-color: var(--color);
  box-shadow: 0 0 20px color-mix(in srgb, var(--color) 30%, transparent),
              0 0 40px color-mix(in srgb, var(--color) 15%, transparent);
  animation: ls-pulse 2s ease-in-out infinite;
}
@keyframes ls-pulse {
  0%, 100% { box-shadow: 0 0 20px color-mix(in srgb, var(--color) 30%, transparent), 0 0 40px color-mix(in srgb, var(--color) 15%, transparent); }
  50% { box-shadow: 0 0 30px color-mix(in srgb, var(--color) 50%, transparent), 0 0 60px color-mix(in srgb, var(--color) 25%, transparent); }
}

.ls-avatar-wrap {
  position: relative; margin-bottom: 0.5rem;
}
.ls-avatar {
  width: 80px; height: 80px; border-radius: 12px; object-fit: cover;
}
.ls-avatar-fb {
  width: 80px; height: 80px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 32px; font-weight: bold;
}
.ls-badge {
  position: absolute; bottom: -6px; left: 50%; transform: translateX(-50%);
  padding: 2px 10px; border-radius: 8px;
  background: var(--color); color: #fff;
  font-size: 11px; font-weight: 700;
}

.ls-body { text-align: center; }
.ls-name { font-size: 15px; font-weight: 600; margin-bottom: 0.2rem; }
.ls-title {
  font-size: 12px; color: #666; margin-bottom: 0.2rem;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 160px;
}
.ls-online { font-size: 12px; color: #999; }
.ls-offline { font-size: 12px; color: #bbb; }
</style>